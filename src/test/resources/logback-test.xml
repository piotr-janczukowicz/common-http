<?xml version="1.0" encoding="UTF-8"?>
<!--
  The console shows warnings only. The library's own debug logging goes to a file, so that the lazily built log
  arguments still run in tests (the JaCoCo thresholds count them) without flooding the build output.
-->
<configuration>
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>target/test-debug.log</file>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="pl.piotrjanczukowicz" level="DEBUG" additivity="false">
    <appender-ref ref="FILE"/>
  </logger>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
